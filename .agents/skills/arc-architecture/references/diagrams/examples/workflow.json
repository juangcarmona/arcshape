      "sublabel": "201 confirmada"
    },
    {
      "id": "rechazar",
      "lane": "excepcion",
      "col": 1,
      "type": "backend",
      "label": "Rechazar",
      "sublabel": "409 conflicto"
    },
    {
      "id": "alternativa",
      "lane": "excepcion",
      "col": 3,
      "type": "frontend",
      "label": "Otras fechas",
      "sublabel": "Nueva solicitud"
    }
