  "edges": [
    {
      "id": "solicitar-validar",
      "from": "solicitar",
      "to": "validar",
      "label": "Consulta",
      "variant": "default"
    },
    {
      "id": "validar-guardar",
      "from": "validar",
      "to": "guardar",
      "label": "Disponible",
      "variant": "emphasis"
    },
    {
      "id": "guardar-confirmar",
      "from": "guardar",
      "to": "confirmar",
      "label": "COMMIT",
      "variant": "default"
    },
    {
      "id": "validar-rechazar",
      "from": "validar",
      "to": "rechazar",
      "label": "Ocupado",
      "variant": "security",
      "role": "error"
