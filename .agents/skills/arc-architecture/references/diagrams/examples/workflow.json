{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "De la solicitud a la confirmación",
    "locale": "es",
    "quality_profile": "showcase",
    "visual_preset": "blueprint",
    "legend": {
      "mode": "auto",
      "entries": {
        "frontend": {
          "label": "Interacción"
        },
        "backend": {
          "label": "Proceso"
        },
        "security": {
          "label": "Decisión"
        },
        "database": {
          "label": "Persistencia"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "viajero",
      "label": "Viajero"
    },
    {
      "id": "reservas",
      "label": "Reservas"
    },
    {
      "id": "excepcion",
      "label": "Sin disponibilidad",
      "variant": "exception"
    }
  ],
  "mainPath": [
    "solicitar",
    "validar",
    "guardar",
    "confirmar"
  ],
  "nodes": [
    {
      "id": "solicitar",
