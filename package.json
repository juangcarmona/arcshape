{
  "name": "arcshape",
  "version": "0.1.0",
  "description": "ArcShape tooling for creating and maintaining arc42 architecture documentation.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/juangcarmona/arcshape.git"
  },
  "homepage": "https://github.com/juangcarmona/arcshape#readme",
  "bugs": {
    "url": "https://github.com/juangcarmona/arcshape/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "arcshape": "bin/arcshape.mjs"
  },
  "files": [
    "bin/",
    "tools/arc42-site/",
    "templates/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@mermaid-js/mermaid-cli": "12.0.0",
    "dompurify": "3.4.16",
    "github-slugger": "2.0.0",
    "ignore": "7.0.12",
    "js-yaml": "5.4.3",
    "jsdom": "27.4.0",
    "marked": "15.0.12",
    "puppeteer": "25.12.0",
    "yauzl": "3.4.0"
  },
  "scripts": {
    "format:check": "prettier --check \"bin/**/*.{js,mjs}\" \"tools/arc42-site/**/*.mjs\" \"scripts/**/*.{ts,js,mjs}\" \"tests/**/*.{ts,js,mjs}\" \"security/**/*.json\" \"*.js\" \"*.json\" \".github/workflows/*.yml\"",
    "lint": "eslint bin scripts tests eslint.config.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc",
    "product:model:check": "node dist/scripts/check-product-model-status.js docs/product/model",
    "security:audit": "node scripts/check-npm-audit.mjs",
    "openspec:init": "openspec init --tools codex,claude",
    "product:init": "prodshape init --sdd openspec --ai codex,claude --full",
    "product:openspec:add": "prodshape integration add openspec"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.14.2",
    "@prodshape/cli": "0.22.0",
    "@types/node": "24.13.3",
    "eslint": "10.13.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "5.0.5"
  }
}
