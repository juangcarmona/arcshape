{
  "name": "arcshape",
  "description": "ArcShape tooling for creating and maintaining arc42 architecture documentation.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "format:check": "prettier --check \"scripts/**/*.ts\" \"tests/**/*.ts\" \"*.js\" \"*.json\" \".github/workflows/*.yml\"",
    "lint": "eslint scripts tests eslint.config.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc",
    "product:model:check": "node dist/scripts/check-product-model-status.js docs/product/model",
    "openspec:init": "openspec init --tools codex,claude",
    "product:init": "prodshape init --sdd openspec --ai codex,claude --full",
    "product:openspec:add": "prodshape integration add openspec"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.14.2",
    "@prodshape/cli": "0.22.0",
    "@types/node": "24.13.3",
    "eslint": "10.13.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "5.0.5"
  }
}
