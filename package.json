{
  "name": "arcshape-repository",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "format:check": "prettier --check \"packages/cli/src/**/*.{js,mjs}\" \"scripts/**/*.{ts,js,mjs}\" \"tests/**/*.{ts,js,mjs}\" \"e2e/**/*.mjs\" \"security/**/*.json\" \"*.{js,mjs,json}\" \".github/workflows/*.yml\" \".github/codeql/*.yml\"",
    "lint": "eslint packages/cli/src scripts tests e2e playwright.config.mjs eslint.config.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "test:e2e": "playwright test",
    "test:mutation": "stryker run",
    "build": "tsc",
    "product:model:check": "node dist/scripts/check-product-model-status.js docs/product/model",
    "security:audit": "node scripts/check-npm-audit.mjs",
    "check:branch": "node scripts/check-branch-name.mjs",
    "version": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release": "changeset publish",
    "openspec:init": "openspec init --tools codex,claude",
    "product:init": "prodshape init --sdd openspec --ai codex,claude --full",
    "product:openspec:add": "prodshape integration add openspec"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@fission-ai/openspec": "1.14.3",
    "@playwright/test": "1.64.1",
    "@prodshape/cli": "0.22.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "24.13.3",
    "eslint": "10.13.0",
    "husky": "9.1.7",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@mermaid-js/mermaid-cli": {
      "katex": "0.18.10"
    }
  }
}
