---
import source from "../../../../docs/architecture/01-introduction-and-goals/README.md?raw";
import PublicLayout from "../layouts/PublicLayout.astro";
import { architecture, repository, portal, tagline, steps } from "../data/site.mjs";
const base = import.meta.env.BASE_URL;
const sourcePath = "docs/architecture/01-introduction-and-goals/README.md";
const paragraph = source.match(/## Requirements overview\s+([^\n]+)/)?.[1];
if (!paragraph) throw new Error("The architecture preview needs its canonical requirements overview.");
const excerpt = paragraph.split(/(?<=\.)\s/)[0];
const markdown = `# 1. Introduction and goals\n\n## Requirements overview\n\n${excerpt}`;
---
<PublicLayout>
  <section class="wrap hero" id="top" aria-labelledby="hero-heading">
    <div class="hero-copy">
      <p class="eyebrow">{tagline}</p>
      <h1 id="hero-heading">Document your software architecture.</h1>
      <p class="lead">ArcShape helps you understand your system, document its structure and decisions, and maintain that knowledge in your repository. Publish a reader from Markdown your team can review in Git.</p>
      <div class="actions">
        <a class="button primary" href={architecture}>Explore the architecture <span aria-hidden="true">↗</span></a>
        <a class="button" href={repository}>View on GitHub <span aria-hidden="true">↗</span></a>
      </div>
      <p class="note">Open source. Markdown in your repository.</p>
    </div>
    <div class="reader" aria-label="Excerpt from ArcShape’s architecture">
      <div class="reader-bar"><strong>ArcShape</strong><span>Architecture reader</span></div>
      <div class="reader-body">
        <p class="section-number">01 / Introduction and goals</p>
        <h2>Introduction and goals</h2>
        <p>{excerpt}</p>
        <ul>
          <li>Repository investigation and evidence</li>
          <li>Architecture decisions and diagrams</li>
          <li>Documentation you can read and share</li>
        </ul>
        <a class="reader-link" href={`${architecture}#/section/01`}>Read introduction and goals <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
  <section class="section" id="workflow" aria-labelledby="workflow-heading">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow">How it works</p>
        <h2 id="workflow-heading">From repository to architecture documentation.</h2>
        <p>Use ArcShape’s agent skills to investigate and document your system. Its CLI handles setup, validation, and reader generation. You review the documentation changes.</p>
      </div>
      <ol class="steps">
        {steps.map((step, index) => <li><span class="step-number">0{index + 1}</span><h3>{step.title}</h3><p>{step.text}</p></li>)}
      </ol>
    </div>
  </section>
  <section class="section source-band" id="artifacts" aria-labelledby="source-heading">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow">Source and reader</p>
        <h2 id="source-heading">Markdown in Git. Architecture on the web.</h2>
        <p>Review documentation alongside your code, then build a reader for the people who need to understand the system. The Markdown stays the source of truth.</p>
      </div>
      <div class="source-pair">
        <article class="document"><h3>In the repository</h3><pre><code>{markdown}</code></pre></article>
        <article class="document"><h3>In the reader</h3><h4 class="excerpt-heading">1. Introduction and goals</h4><h5 class="excerpt-subheading">Requirements overview</h5><p>{excerpt}</p></article>
      </div>
      <div class="inline-links"><a href={`${repository}/blob/main/${sourcePath}`}>Read the Markdown source</a><a href={`${architecture}#/section/01`}>Read introduction and goals</a><a href={portal}>Visit the engineering portal</a></div>
    </div>
  </section>
  <section class="section" aria-labelledby="framework-heading">
    <div class="wrap framework">
      <div><p class="eyebrow">A structure for your documentation</p><h2 id="framework-heading">Built on arc42.</h2><p>ArcShape uses arc42, a template for documenting software architecture. Its twelve sections help you explain a system’s goals, structure, behavior, and decisions.</p></div>
      <a class="button" href={`${base}arc42/`}>Learn about arc42 <span aria-hidden="true">→</span></a>
    </div>
  </section>
</PublicLayout>
