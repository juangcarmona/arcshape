{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeQL",
          "rules": [
            {
              "id": "js/code-injection",
              "properties": { "security-severity": "8.1" }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "js/code-injection",
          "level": "error",
          "message": { "text": "Synthetic code injection finding for gate testing." },
          "properties": { "security-severity": "8.1" }
        }
      ]
    }
  ]
}
